# Application Settings
APP_NAME=Dynamic Content Blocks System
APP_VERSION=1.0.0
DEBUG=False

# Security / JWT
# Required in production so all API workers/replicas share the same signing key.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=

# Neo4j Graph Database
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_neo4j_password_here

# MongoDB Document Database
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=content_blocks

# Elasticsearch
# Note: app/repositories/elasticsearch_repo.py reads ELASTICSEARCH_URI,
# while app/config.py reads ELASTICSEARCH_HOST / ELASTICSEARCH_PORT.
ELASTICSEARCH_URI=http://localhost:9200
ELASTICSEARCH_HOST=localhost
ELASTICSEARCH_PORT=9200
ELASTICSEARCH_INDEX=blocks

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# Celery Task Queue
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# NLP Models
SPACY_MODEL=de_core_news_lg
SENTENCE_TRANSFORMER_MODEL=paraphrase-multilingual-MiniLM-L12-v2

# API Keys (optional)
OPENAI_API_KEY=

# Data Paths
DATA_DIR=./data
RAW_DATA_DIR=./data/raw
PROCESSED_DATA_DIR=./data/processed
MODELS_DIR=./data/models
